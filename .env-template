# Copy this file to .env and fill in the values from the Supabase project dashboard.
# Never commit a populated .env file.

# Project URL, for example https://your-project.supabase.co
NG_APP_SUPABASE_URL=

# Publishable (or legacy anon) key for browser use. Never place a service_role key here.
NG_APP_SUPABASE_ANON_KEY=
